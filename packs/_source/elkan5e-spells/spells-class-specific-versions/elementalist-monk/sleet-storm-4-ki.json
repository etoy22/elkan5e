	"system": {
		"description": {
			"value": "<p><em>You place a pinch of dust in your palm, sprinkle it with water, and rub your hands together forming a thin gray paste as you call on supernatural cold. A freezing downpour coats the land with ice and fills the air with blinding sleet.</em></p><p><strong>[[/save dex]]{Dexterity Save}</strong></p><ul><li><p><strong>Failure:</strong> Target is &amp;reference[prone].</p></li><li><p><strong>Success:</strong> No effect.</p></li><li><p><strong>Area Hazard:</strong> The area is &amp;reference[difficult terrain], &amp;reference[heavilyobscured] and nonmagical fire is doused. When a creature enters the area or ends their turn there (but not both), they must roll a save against the spell.</p></li></ul>",
			"chat": ""
		},
