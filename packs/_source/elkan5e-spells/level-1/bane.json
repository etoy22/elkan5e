	"system": {
		"description": {
			"value": "<p><em>Holding out a holy or profane symbol, you call upon its power to condemn or weaken your targets.</em></p><p><strong>[[/save cha]]{Charisma Save}</strong></p><ul><li><p><strong>Failure:</strong> The target must subtract [[/r 1d4]] from all &amp;reference[attackrolls]{attack rolls} and &amp;reference[savingthrow]{saving throws} for the duration, rolling 1d4 again for every roll. Target rolls again at end of their turns, ending effect on success.</p></li><li><p><strong>Success:</strong> No effect.</p></li></ul><p><strong>Upcasting:</strong> Target one additional creature for each spell level above 1st.</p>",
			"chat": ""
		},
