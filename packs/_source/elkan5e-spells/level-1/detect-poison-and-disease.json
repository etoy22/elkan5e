		"midi-qol": {
			"effectActivation": false,
			"AoETargetType": "any",
			"AoETargetTypeIncludeSelf": false,
			"autoTarget": "default",
			"itemCondition": "",
			"reactionCondition": "",
			"otherCondition": "",
			"effectCondition": "(() => { const a = target.actor; if (a.statuses.has('poisoned') || a.statuses.has('diseased')) return true; const has = (c, v) => !!c && (c.has ? c.has(v) : Array.from(c).includes(v)); for (const i of a.items) { for (const act of (i.system?.activities ?? [])) { for (const p of (act.damage?.parts ?? [])) { if (has(p.types, 'poison')) return true; } } for (const e of (i.effects ?? [])) { if (has(e.statuses, 'poisoned') || has(e.statuses, 'diseased')) return true; } } return false; })()",
