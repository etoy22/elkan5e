	"system": {
		"description": {
			"value": "<p><em>You hold forth a holy symbol or a cultural icon associated with the dead, then call forth spirits to protect you. They flit around you, striking your enemies at your direction and harrying their movement.</em></p><p>This spell targets all creatures of your choice and ignores &amp;reference[cover].</p><p><strong>[[/save wis]]{Wisdom Save}</strong></p><ul><li><p><strong>Failure:</strong> <strong></strong> Targets take [[/damage 3d8 radiant]] damage* .</p></li><li><p><strong>Success:</strong> Half damage.</p></li><li><p><strong>Area Hazard:</strong> The area within 15 ft. of you is &amp;reference[difficult terrain] for hostile creatures.</p></li><li><p><strong>&amp;reference[concentration]{Concentration}:</strong> Once on each subsequent turn, you can make the spirits target all creatures within 15 ft. of you again.</p></li></ul><p><strong>Upcasting:</strong> Increase damage by [[/damage 1d8 radient]]{1d8} for each spell level above 3rd.</p>",
			"chat": ""
		},
