	"effects": [
		{
			"type": "enchantment",
			"name": "Jester (Vicious Mockery)",
			"img": "icons/magic/control/fear-fright-monster-grin-purple-blue.webp",
			"disabled": false,
			"transfer": false,
			"_id": "1fKzeY2G93L25dGm",
			"system": {
				"changes": [
					{
						"phase": "initial",
						"priority": 20,
						"_id": "Qh03GmGpAN1PjAQZ",
						"conditions": "{}",
						"replacement": "",
						"key": "system.description.value",
						"type": "override",
						"value": "<p><em>You unleash your magic upon your target as you viciously insult them.</em></p><p><strong>[[/save wis]]{Wisdom Save}</strong></p><p>Your target must be able to hear you, but does not need to understand you.</p><ul><li><p><strong>Failure:</strong> Target takes psychic damage equal to one roll of your @UUID[Compendium.elkan5e.elkan5e-class-features.Item.kg7VBahhFH6gDFIh]{bardic inspiration} die,* and has &amp;reference[disadvantage] on their next &amp;reference[attackrolls]{attack roll}.</p></li><li><p><strong>Success:</strong> No effect.</p></li></ul><p><strong>*At Higher Levels:</strong> This spell's damage increases by 1 bardic inspiration die when you reach a total character or creature level of 5th level, 11th level, and 17th level.</p>"
					},
					{
						"phase": "initial",
