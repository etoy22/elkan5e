	"effects": [
		{
			"type": "enchantment",
			"name": "Empowered Cantrips (Acid Splash)",
			"img": "icons/magic/acid/projectile-glowing-bubbles.webp",
			"disabled": false,
			"transfer": false,
			"_id": "hAlmoWXI8DSK9ENz",
			"system": {
				"changes": [
					{
						"phase": "initial",
						"priority": null,
						"_id": "F5iHzCefeimRbaeJ",
						"conditions": "{}",
						"replacement": "",
						"key": "system.description.value",
						"type": "override",
						"value": "<p><em>You form a ball of acid between your hands and hurl it. It bursts on impact with the ground and melts nearby creatures.</em></p><p><strong>[[/save dex]]{Dexterity Save}</strong></p><ul><li><p><strong>Failure:</strong> Target takes [[/damage 1d8 acid]] damage.*</p></li><li><p><strong>Success:</strong> No damage.</p></li></ul><p><strong>*At Higher Levels:</strong> This spell's damage increases by 1d8 when you reach a total character or creature level of 5th level ([[/damage 2d8 acid]]), 11th level ([[/damage 3d8 acid]]), and 17th level ([[/damage 4d8 acid]]).</p>"
					},
					{
						"phase": "initial",
						"priority": null,
