		{
			"type": "enchantment",
			"name": "Empowered Cantrips (Static Charge)",
			"img": "icons/magic/lightning/projectile-tendrils-teal.webp",
			"disabled": false,
			"transfer": false,
			"_id": "K3HOiMo4lJp2CVoR",
			"system": {
				"changes": [
					{
						"phase": "initial",
						"priority": null,
						"_id": "ZH5WKAlBmpmfgeqT",
						"conditions": "{}",
						"replacement": "",
						"key": "system.description.value",
						"type": "override",
						"value": "<p><em>You hold out a small conductive metal rod , pointing at your target, concentrating static electricity around them.</em></p><p><strong>Constitution</strong> <strong>Save</strong></p><ul><li><p><strong>Failure:</strong> Target takes [[/damage 1d8 lightning]] damage <strong>*</strong> and target has disadvantage on their next skill check or &amp;reference[savingthrow]{saving throw}.</p></li><li><p><strong>Success:</strong> No Effect</p></li></ul><p><strong>*At Higher Levels:</strong> The spell's damage increases by 1d8 when you reach a total character or creature level of 5th level ([[/damage 2d8 lightning]]), 11th level ([[/damage 3d8 lightning]]), and 17th level ([[/damage 4d8 lightning]]).</p><p><em>Any creature touching your target is harmlessly shocked. At the GM's discretion, the target may not suffer disadvantage on a saving throw against electricity damage (due to lightning taking the path of least resistance).</em></p>"
					},
