	"system": {
		"description": {
			"value": "<p><strong>Action</strong></p><ul><li><p>The [[lookup @name lowercase]] throws a creature it is grappling of Medium size or smaller up to 20 feet away, off ledges if possible. The target takes [[/damage 2d6 bludgeoning]] damage and has the &amp;Reference[Prone apply=false] condition at the end of this movement.</p></li></ul><p>If the thrown target strikes another creature during this movement, that creature is affected:</p><p><strong>[[/save dexterity]]{Dexterity Save}</strong></p><ul><li><p><strong>Failure:</strong> [[/damage 2d6 bludgeoning]] damage, and the creature has the &amp;Reference[Prone apply=false] condition.</p></li><li><p><strong>Success:</strong> No effect.</p></li></ul>",
			"chat": ""
		},
